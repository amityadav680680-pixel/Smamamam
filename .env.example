# Server
HOST=0.0.0.0
PORT=8000
PUBLIC_BASE_URL=http://localhost:8000

# Security — change these before deploying
WEBHOOK_API_KEY=change-me-to-a-long-random-secret
ADMIN_API_KEY=change-me-admin-secret

# Telegram
TELEGRAM_BOT_TOKEN=123456:ABC-DEF_your_bot_token_from_BotFather
# Comma-separated Telegram user IDs allowed to use the bot (required)
TELEGRAM_ALLOWED_USER_IDS=123456789

# Database
DATABASE_URL=sqlite+aiosqlite:///./data/sms_monitor.db

# Optional: push every new SMS to Telegram immediately
TELEGRAM_PUSH_NEW_SMS=true
